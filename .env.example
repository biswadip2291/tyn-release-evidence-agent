# Copy to .env and fill in. Never commit .env; this example file must only contain placeholders.

# Jira Cloud site, e.g. https://your-site.atlassian.net (no trailing slash)
JIRA_BASE_URL=https://your-site.atlassian.net
# The Atlassian account email that owns the API token
JIRA_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# Anthropic API key, from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_EFFORT=high
# JIRA_ISSUE_TYPE=Task
